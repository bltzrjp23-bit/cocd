<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Clash Kingdom Investment Platform</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        body {
            background-color: #120e0c;
            color: #f5f5f1;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
        }
        .container {
            width: 100%;
            max-width: 480px;
            background-color: #241a16;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            position: relative;
            box-shadow: 0 0 30px rgba(0,0,0,0.9);
            overflow-y: auto;
            padding-bottom: 75px;
            border-left: 2px solid #5c4033;
            border-right: 2px solid #5c4033;
        }
        .screen {
            display: none;
            flex: 1;
            padding: 20px;
        }
        .screen.active {
            display: flex;
            flex-direction: column;
        }

        /* Headers & Branding */
        .app-header {
            font-size: 20px;
            font-weight: bold;
            color: #ffcc00;
            margin-bottom: 15px;
            text-shadow: 2px 2px #000;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .badge-th {
            background: #8b5a2b;
            padding: 3px 10px;
            border-radius: 6px;
            color: #fff;
            font-size: 12px;
            border: 1px solid #d4af37;
        }

        /* Auth Forms */
        .auth-box {
            background-color: #382820;
            padding: 25px;
            border-radius: 12px;
            border: 2px solid #8b5a2b;
            margin-top: 20px;
        }
        .input-group {
            margin-bottom: 15px;
        }
        .input-group label {
            display: block;
            font-size: 13px;
            color: #d4af37;
            margin-bottom: 6px;
            font-weight: bold;
        }
        .input-field {
            width: 100%;
            background-color: #120e0c;
            border: 1px solid #8b5a2b;
            color: #fff;
            padding: 12px;
            font-size: 14px;
            border-radius: 6px;
            outline: none;
        }
        .btn-coc {
            background: linear-gradient(to bottom, #7cd314, #48800a);
            color: #fff;
            border: 2px solid #2e5204;
            width: 100%;
            padding: 14px;
            border-radius: 8px;
            font-size: 15px;
            font-weight: bold;
            cursor: pointer;
            text-shadow: 1px 1px #000;
            box-shadow: 0 4px #1c3202;
            margin-top: 10px;
        }
        .btn-coc:active {
            transform: translateY(2px);
            box-shadow: 0 2px #1c3202;
        }
        .btn-gold {
            background: linear-gradient(to bottom, #ffcc00, #cc9900);
            color: #120e0c;
            border: 1px solid #fff;
        }

        /* Cards & Grid */
        .townhall-card {
            background: linear-gradient(135deg, #4b3621, #241a16);
            border: 2px solid #d4af37;
            padding: 20px;
            border-radius: 14px;
            margin-bottom: 20px;
        }
        .grid-stats {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
            margin-bottom: 20px;
        }
        .stat-card {
            background-color: #382820;
            padding: 15px;
            border-radius: 10px;
            border: 1px solid #8b5a2b;
        }
        .stat-card span {
            font-size: 12px;
            color: #d4af37;
        }
        .stat-card h3 {
            font-size: 18px;
            margin-top: 5px;
            color: #fff;
        }

        /* Marketplace */
        .troop-card {
            background-color: #382820;
            border: 2px solid #8b5a2b;
            border-radius: 12px;
            padding: 15px;
            margin-bottom: 15px;
            display: flex;
            gap: 15px;
            align-items: center;
        }
        .troop-img {
            width: 65px;
            height: 65px;
            background: #120e0c;
            border-radius: 8px;
            border: 1px solid #d4af37;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 30px;
        }
        .troop-info {
            flex: 1;
        }
        .troop-name {
            font-size: 16px;
            font-weight: bold;
            color: #ffcc00;
        }
        .troop-detail {
            font-size: 12px;
            color: #ccc;
            margin: 2px 0;
        }

        /* Bottom Nav */
        .nav-bar {
            position: absolute;
            bottom: 0;
            left: 0;
            width: 100%;
            background-color: #140e0c;
            border-top: 2px solid #5c4033;
            display: flex;
            justify-content: space-around;
            padding: 10px 0;
            z-index: 100;
        }
        .nav-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            color: #a89f91;
            font-size: 11px;
            cursor: pointer;
            background: none;
            border: none;
            font-weight: bold;
        }
        .nav-item.active {
            color: #ffcc00;
        }
        .nav-icon {
            font-size: 20px;
            margin-bottom: 2px;
        }
    </style>
</head>
